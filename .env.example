DATABASE_URL=postgresql+psycopg://widget:widget@db:5432/widgetdb
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_MINUTES=60
GEO_PROVIDER_A_URL=http://ip-api.com/json/{ip}
GEO_PROVIDER_B_URL=https://ipapi.co/{ip}/json/
GEO_PROVIDER_A_DISABLED=false
GEO_PROVIDER_B_DISABLED=false
RATE_LIMIT_PER_IP=20/minute
RATE_LIMIT_PER_WIDGET=100/minute
CORS_ALLOW_ORIGINS=*
NOTIFY_FORCE_FAILURE=false
